name: CI

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  macos:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v6
      - name: Repository checks
        run: make validate
      - name: Make workflow orchestration
        run: make workflow-test
      - name: SwiftPM tests and executable build
        run: |
          make test
          make package-build
      - name: Assemble macOS application
        run: make build
