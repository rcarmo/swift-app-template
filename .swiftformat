--swift-version 6.0
--language-mode 6
--indent 2
--max-width 120
--wrap-arguments before-first
--wrap-parameters before-first
--wrap-collections before-first
--wrap-conditions before-first
--closing-paren balanced
--call-site-paren balanced
--trailing-commas multi-element-lists
--import-grouping testable-bottom
--self remove
--trim-whitespace always
--exclude .build,build,dist
--enable blankLinesBetweenScopes,consecutiveSpaces,duplicateImports,hoistPatternLet,isEmpty,linebreakAtEndOfFile,preferCountWhere,redundantBackticks,redundantParens,redundantReturn,redundantSelf,redundantType,sortImports,trailingCommas,trailingSpace,typeSugar
